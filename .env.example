# ==============================================================================
# PolicyLens Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME=PolicyLens
APP_VERSION=0.1.0

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Dataset Configuration
DEFAULT_DATASET_PATH=../data/samples/consultation_demo_dataset.csv
DATASET_ENCODING=utf-8

# NLP / AI Provider Configuration
# Supported providers: "local" (default rule/heuristic engine), "mock"
SENTIMENT_PROVIDER=local
TOPIC_PROVIDER=local
EXTRACTION_PROVIDER=local
SUMMARIZATION_PROVIDER=local
INSIGHT_PROVIDER=local

# Optional External API Keys (Not required for milestone 1)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
